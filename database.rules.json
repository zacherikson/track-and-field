{
  "rules": {
    "lobby": {
      "$kind": {
        ".read": "auth != null && $kind.matches(/^(sprint100|longjump|hurdles110|polevault|javelin|tournament|teamtournament)$/)",
        // The waiting room is one node that every phone rewrites in a transaction (online/live.js Lobby), so the write has to be allowed here rather than per player. A write must leave a room id behind, which is what stops the node being wiped: a .validate rule can't, as none is run when the new data is null.
        ".write": "auth != null && $kind.matches(/^(sprint100|longjump|hurdles110|polevault|javelin|tournament|teamtournament)$/) && newData.hasChild('room')",
        // A room id only changes when live.js starts a new room (this one closed, or full), and a new room holds one player, so it has no start time yet.
        "room": { ".validate": "newData.isString() && newData.val().length <= 40 && (newData.val() === data.val() || !newData.parent().child('startAt').exists())" },
        // A start is always a few seconds out (START_DELAY), so one parked far ahead (a room that never closes) or in the past isn't one of ours.
        "startAt": { ".validate": "newData.isNumber() && newData.val() > now - 30000 && newData.val() < now + 60000" },
        "setLen": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
        // Your own entry is yours to write. Everyone else's has to come back exactly as it stands, which is what a transaction rewriting the node does anyway.
        "players": {
          "$uid": {
            ".validate": "newData.hasChildren(['name', 'at'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && (auth.uid === $uid || newData.val() === data.val())" },
            "athlete": { ".validate": "newData.isString() && newData.val().length <= 32 && (auth.uid === $uid || newData.val() === data.val())" },
            "lineup": { "$event": { ".validate": "$event.matches(/^(sprint100|longjump|hurdles110|polevault|javelin)$/) && newData.isString() && newData.val().length <= 32 && (auth.uid === $uid || newData.val() === data.val())" } },
            "at": { ".validate": "newData.isNumber() && (auth.uid === $uid || newData.val() === data.val())" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    // A squad's practice rooms (online/live.js watchSquadRooms): the same waiting room as lobby/, one set per squad, and the 4x100m relay too.
    // $squad is the squad's key made safe for a database key (live.js squadRoomKey). Who may join isn't checked here (squads live in Firestore): only its members are shown it.
    "squadlobby": {
      "$squad": {
        ".read": "auth != null && $squad.length <= 160",
        "$kind": {
          // The waiting room is one node that every phone rewrites in a transaction (online/live.js Lobby), so the write has to be allowed here rather than per player. A write must leave a room id behind, which is what stops the node being wiped: a .validate rule can't, as none is run when the new data is null.
          ".write": "auth != null && $kind.matches(/^(sprint100|longjump|hurdles110|polevault|javelin|tournament|teamtournament|relay4x100)$/) && newData.hasChild('room')",
          // A room id only changes when live.js starts a new room (this one closed, or full), and a new room holds one player, so it has no start time yet.
          "room": { ".validate": "newData.isString() && newData.val().length <= 40 && (newData.val() === data.val() || !newData.parent().child('startAt').exists())" },
          // A start is always a few seconds out (START_DELAY), so one parked far ahead (a room that never closes) or in the past isn't one of ours.
          "startAt": { ".validate": "newData.isNumber() && newData.val() > now - 30000 && newData.val() < now + 60000" },
          "setLen": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
          // Your own entry is yours to write. Everyone else's has to come back exactly as it stands, which is what a transaction rewriting the node does anyway.
          "players": {
            "$uid": {
              ".validate": "newData.hasChildren(['name', 'at'])",
              "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && (auth.uid === $uid || newData.val() === data.val())" },
              "athlete": { ".validate": "newData.isString() && newData.val().length <= 32 && (auth.uid === $uid || newData.val() === data.val())" },
              "lineup": { "$event": { ".validate": "$event.matches(/^(sprint100|longjump|hurdles110|polevault|javelin)$/) && newData.isString() && newData.val().length <= 32 && (auth.uid === $uid || newData.val() === data.val())" } },
              "at": { ".validate": "newData.isNumber() && (auth.uid === $uid || newData.val() === data.val())" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    },
    "live": {
      "$room": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          "v": { ".validate": "newData.isNumber()" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "athlete": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "lineup": { "$event": { ".validate": "$event.matches(/^(sprint100|longjump|hurdles110|polevault|javelin)$/) && newData.isString() && newData.val().length <= 32" } },
          "left": { ".validate": "newData.isBoolean()" },
          "s": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "t0": { ".validate": "newData.isNumber()" },
          "run": {
            "ev": { ".validate": "newData.hasChildren() && !newData.hasChild('4000')" }
          },
          "n": { ".validate": "newData.isNumber()" },
          "done": { ".validate": "newData.isBoolean()" },
          "f": {
            // Chunks of frames, ten a second: 100 s of them (a slow 4x100m relay runs past a minute).
            ".validate": "!newData.hasChild('1000')",
            "$k": { ".validate": "newData.isString() && newData.val().length <= 100000" }
          },
          "res": {
            "$stage": {
              "mark": { ".validate": "newData.isNumber()" },
              "foul": { ".validate": "newData.isBoolean()" },
              "fail": { ".validate": "newData.isBoolean()" },
              "status": { ".validate": "newData.isString() && newData.val().length <= 8" },
              "$other": { ".validate": false }
            }
          },
          "ready": {
            "$stage": { ".validate": "newData.isNumber()" }
          },
          "b": {
            ".validate": "newData.hasChildren(['k', 'x', 'd'])",
            "k": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "x": { ".validate": "newData.isNumber()" },
            "d": { ".validate": "newData.isNumber()" },
            "f": { ".validate": "newData.isNumber()" },
            "s": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "n": { ".validate": "newData.isNumber()" },
            "e": { ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 12)" },
            "h": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "$other": { ".validate": false }
          },
          "h": {
            "$n": {
              ".validate": "$n.matches(/^[0-9]{1,6}$/) && newData.hasChildren(['k', 'to', 't', 'at'])",
              "k": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "to": { ".validate": "newData.isString() && newData.val().length <= 128" },
              "t": { ".validate": "newData.isString() && newData.val().length <= 8" },
              "s": { ".validate": "newData.isNumber()" },
              "f": { ".validate": "newData.isNumber()" },
              "at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
