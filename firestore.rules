rules_version = '2';

// Security rules for the online leaderboard and usernames (see src/online/firebase.js).
// Paste into Firebase console > Firestore Database > Rules, then Publish.
//
// Anyone can read. A signed-in player (anonymous sign-in) can only write their
// own profile, their own name claim, and their own leaderboard entries (only
// with a better mark, or to change their name).
service cloud.firestore {
  match /databases/{database}/documents {
    // Your profile. Saved in the same transaction as the name claim below,
    // which must point back at you.
    match /users/{uid} {
      allow read: if true;
      allow write: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'key', 'updatedAt'])
        && validName(request.resource.data.name)
        && request.resource.data.key == request.resource.data.name.lower()
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.key)).data.uid == uid;
    }

    // One doc per username (lowercased), so no two players share a name.
    match /usernames/{key} {
      allow read: if true;
      allow create: if claimIsMine(key);
      allow update: if resource.data.uid == request.auth.uid && claimIsMine(key);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.key != key;
    }

    // One board per event plus the tournament score (registry.js BOARDS).
    match /leaderboards/{event}/runs/{uid} {
      allow read: if event in ['sprint100', 'longjump', 'hurdles110', 'polevault', 'javelin', 'tournament'];
      allow create: if isMe(uid) && validRun(event, request.resource.data);
      allow update: if isMe(uid) && (
        (validRun(event, request.resource.data) && beats(event, request.resource.data.mark, resource.data.mark))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && validName(request.resource.data.name)));
      allow delete: if false;
    }

    function isMe(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 1-16 characters, no '/', not starting with '_', '.' or a space.
    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 16 && n.matches('[^/_. ][^/]*');
    }

    // Claiming `key` for yourself, with your profile (after this write) using it.
    function claimIsMine(key) {
      return request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.key == key;
    }

    // Basic sanity checks only: the server doesn't replay the run to prove the mark.
    // The 100m entry carries its recorded run (the ghost); no other board has one.
    function validRun(event, d) {
      return d.keys().hasOnly(['name', 'mark', 'ghost', 'v', 'createdAt'])
        && d.keys().hasAll(['name', 'mark', 'v', 'createdAt'])
        && validName(d.name)
        && validMark(event, d.mark)
        && d.v == 1
        && d.createdAt == request.time
        && ((event == 'sprint100' && d.keys().hasAll(['ghost']) && validGhost(d))
            || (event != 'sprint100' && !d.keys().hasAny(['ghost'])));
    }

    function validGhost(d) {
      return d.ghost is map && d.ghost.mark == d.mark && d.ghost.v == 1
        && d.ghost.ev is list && d.ghost.ev.size() <= 4000;
    }

    // Times in seconds, distances and heights in metres, tournament in points.
    function validMark(event, m) {
      return m is number && (
        (event == 'sprint100' && m >= 7 && m <= 60)
        || (event == 'hurdles110' && m >= 8 && m <= 120)
        || (event == 'longjump' && m > 0 && m <= 15)
        || (event == 'polevault' && m > 0 && m <= 9)
        || (event == 'javelin' && m > 0 && m <= 150)
        || (event == 'tournament' && m >= 1 && m <= 15000));
    }

    // True if mark a is better than mark b: lower times win, the rest go higher.
    function beats(event, a, b) {
      return (event in ['sprint100', 'hurdles110'] && a < b)
        || (!(event in ['sprint100', 'hurdles110']) && a > b);
    }
  }
}
