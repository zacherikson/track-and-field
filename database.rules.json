{
  "rules": {
    "lobby": {
      "$kind": {
        ".read": "auth != null && $kind.matches(/^(sprint100|longjump|hurdles110|polevault|javelin|tournament)$/)",
        ".write": "auth != null && $kind.matches(/^(sprint100|longjump|hurdles110|polevault|javelin|tournament)$/)",
        "room": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "startAt": { ".validate": "newData.isNumber()" },
        "setLen": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
        "players": {
          "$uid": {
            ".validate": "newData.hasChildren(['name', 'at'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
            "athlete": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "live": {
      "$room": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          "v": { ".validate": "newData.isNumber()" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "athlete": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "left": { ".validate": "newData.isBoolean()" },
          "s": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "t0": { ".validate": "newData.isNumber()" },
          "run": {
            "ev": { ".validate": "newData.hasChildren() && !newData.hasChild('4000')" }
          },
          "n": { ".validate": "newData.isNumber()" },
          "done": { ".validate": "newData.isBoolean()" },
          "f": {
            ".validate": "!newData.hasChild('400')",
            "$k": { ".validate": "newData.isString() && newData.val().length <= 100000" }
          },
          "res": {
            "$stage": {
              "mark": { ".validate": "newData.isNumber()" },
              "foul": { ".validate": "newData.isBoolean()" },
              "fail": { ".validate": "newData.isBoolean()" },
              "status": { ".validate": "newData.isString() && newData.val().length <= 8" },
              "$other": { ".validate": false }
            }
          },
          "ready": {
            "$stage": { ".validate": "newData.isNumber()" }
          },
          "b": {
            ".validate": "newData.hasChildren(['k', 'x', 'd'])",
            "k": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "x": { ".validate": "newData.isNumber()" },
            "d": { ".validate": "newData.isNumber()" },
            "f": { ".validate": "newData.isNumber()" },
            "s": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "n": { ".validate": "newData.isNumber()" },
            "e": { ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 12)" },
            "h": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "$other": { ".validate": false }
          },
          "h": {
            "$n": {
              ".validate": "$n.matches(/^[0-9]{1,6}$/) && newData.hasChildren(['k', 'to', 't', 'at'])",
              "k": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "to": { ".validate": "newData.isString() && newData.val().length <= 128" },
              "t": { ".validate": "newData.isString() && newData.val().length <= 8" },
              "s": { ".validate": "newData.isNumber()" },
              "f": { ".validate": "newData.isNumber()" },
              "at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
